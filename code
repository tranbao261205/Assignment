
#include <stdio.h>
#include <stdint.h>


uint8_t gf_multiply(uint8_t a, uint8_t b,
                    int m, uint16_t poly)
{
    uint16_t result = 0;
    uint16_t high_bit = 1u << m;
    uint16_t mask = high_bit - 1;

    while (b != 0) {
      
        if (b & 1)
            result ^= a;

        b >>= 1;

       
        a <<= 1;

        
        if (a & high_bit)
            a ^= poly;

        a &= mask;
    }

    return (uint8_t)(result & mask);
}

int main(void)
{
    unsigned int a, b;

    printf("=== NHAN DA THUC TRONG TRUONG HUU HAN ===\n");
    printf("1. GF(2^4)\n");
    printf("2. GF(2^8)\n");
    printf("Chon truong: ");

    int choice;
    if (scanf("%d", &choice) != 1)
        return 1;

    int m;
    uint16_t poly;

    if (choice == 1) {
        m = 4;
        poly = 0x13; 
        printf("Nhap a, b (0..15): ");
    } else if (choice == 2) {
        m = 8;
        poly = 0x11B; 
        printf("Nhap a, b (0..255): ");
    } else {
        printf("Lua chon khong hop le!\n");
        return 1;
    }

    if (scanf("%u %u", &a, &b) != 2)
        return 1;

    unsigned int limit = 1u << m;

    if (a >= limit || b >= limit) {
        printf("Gia tri dau vao vuot gioi han!\n");
        return 1;
    }

    uint8_t result = gf_multiply(
        (uint8_t)a, (uint8_t)b, m, poly
    );

    printf("Ket qua: %u (thap phan), 0x%X (hex)\n",
           result, result);

    return 0;
}
